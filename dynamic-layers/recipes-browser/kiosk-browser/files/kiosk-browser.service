[Unit]
Description=Chessboard Startup Service
After=network.target

[Service]
Type=simple
TimeoutStartSec=0
Restart=always
RestartSec=3
KillMode=control-group
Environment=DISPLAY=:0 QT_QPA_PLATFORM=linuxfb:fb=/dev/fb1:nographicsmodeswitch=1
ExecStart=/bin/sh -c '\
    URL="KIOSK_BROWSER_URL"; \
    check() { wget --spider -q --timeout=2 "$URL" > /dev/null 2>&1; }; \
    until check; do sleep 1; done; \
    while true; do \
        kiosk-browser "$URL" & pid=$!; \
        while check && kill -0 "$pid" 2>/dev/null; do sleep 2; done; \
        kill -TERM "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; \
        until check; do sleep 1; done; \
    done'


[Install]
WantedBy=multi-user.target
